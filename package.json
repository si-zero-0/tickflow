{
  "name": "tickflow-workspace",
  "version": "1.13.0",
  "private": true,
  "description": "刻度 TickFlow 开发工作区（只做命令编排，无运行时依赖；真正的 Electron 依赖在 src/main）",
  "scripts": {
    "start": "npm --prefix src/main run start",
    "stage": "node scripts/build.mjs --stage-only",
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "release:prepare": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs --check",
    "test": "node --test \"tests/**/*.test.mjs\""
  }
}
